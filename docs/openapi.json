    "/api/items/by-barcode/{barcode}": {
      "get": {
        "description": "Exact match on the scanned code. This is what the scanner sheet calls after each\ndetection; a 404 is expected and simply means the code is not in the catalogue,\nso the app reports it and keeps scanning.",
        "operationId": "byBarcode",
        "parameters": [
          {
            "description": "The scanned code, e.g. an EAN-13",

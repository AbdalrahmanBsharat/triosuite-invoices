    "/api/invoices/{id}/approve": {
      "post": {
        "description": "DRAFT to APPROVED, stamping who approved it and when. The invoice becomes\nread-only: every later write returns 409 INVOICE_NOT_EDITABLE.\n\nAn invoice with no lines cannot be approved.",
        "operationId": "approve",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {

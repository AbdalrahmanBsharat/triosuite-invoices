          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Invoice"
                }
              }
            },
            "description": "Draft replaced"
          },
          "400": {
            "description": "Invalid body, or an inactive customer, currency or item"
          },
          "404": {
            "description": "No such invoice"
          },
          "409": {
            "description": "STALE_VERSION or INVOICE_NOT_EDITABLE"
          }
        },
        "summary": "Replace a draft invoice",
        "tags": [
          "Invoices"
        ]

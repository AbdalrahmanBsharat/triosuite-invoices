        },
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Invoice"
                }
              }
            },
            "description": "Approved"
          },
          "400": {
            "description": "The invoice has no lines"
          },
          "404": {
            "description": "No such invoice"
          },
          "409": {
            "description": "STALE_VERSION or INVALID_TRANSITION"
          }
        },
        "summary": "Approve an invoice",
        "tags": [
          "Invoices"
        ]
      }

# =====================================================================================
# Triosuite Invoices API — environment template.
#
#   cp .env.example .env
#
# .env is git-ignored and must never be committed. Every variable below is read by both
# docker-compose.yml and the Spring application (see backend/src/main/resources/application.yml).
# =====================================================================================

# -------------------------------------------------------------------------------------
# Profile
# -------------------------------------------------------------------------------------
# local | test | prod   — `prod` refuses to start without JWT_SECRET and DB credentials.
SPRING_PROFILES_ACTIVE=prod

# -------------------------------------------------------------------------------------
# Database
# -------------------------------------------------------------------------------------
# Used by the MySQL container only.
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=triosuite
MYSQL_HOST_PORT=3306

# Used by both the MySQL container and the API.
DB_USERNAME=triosuite
DB_PASSWORD=change-me-database-password

# Used by the API when it is NOT started through docker-compose (compose builds this itself).
# Managed MySQL (Aiven, PlanetScale, RDS) needs sslMode=REQUIRED instead of DISABLED.
#   jdbc:mysql://<host>:<port>/<database>?sslMode=REQUIRED&characterEncoding=utf8&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
DB_URL=jdbc:mysql://127.0.0.1:3306/triosuite?sslMode=DISABLED&allowPublicKeyRetrieval=true&characterEncoding=utf8&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true

# Optional connection-pool sizing. Keep the maximum small on a 512 MB host.
DB_POOL_MAX=10
DB_POOL_MIN=2

# -------------------------------------------------------------------------------------
# Security
# -------------------------------------------------------------------------------------
# HS256 signing key — at least 32 bytes. Startup fails if it is shorter. Generate one with:
#   openssl rand -base64 48
#   (PowerShell) [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
JWT_SECRET=replace-with-openssl-rand-base64-48-output-at-least-32-bytes

JWT_ISSUER=triosuite-invoices-api
# ISO-8601 durations.
JWT_ACCESS_TTL=PT30M
JWT_REFRESH_TTL=P30D

# Comma-separated exact origins allowed to call the API from a browser.
# The Flutter Android app is not a browser and does not need an entry here; leave empty
# unless you also serve a web client.
CORS_ALLOWED_ORIGINS=

# Brute-force protection on POST /api/auth/login (per username and per client IP).
LOGIN_MAX_ATTEMPTS=5
LOGIN_RATE_WINDOW=PT1M

# -------------------------------------------------------------------------------------
# Runtime
# -------------------------------------------------------------------------------------
# Hosting platforms (Render, Railway, Fly.io) inject PORT themselves.
PORT=8080
API_HOST_PORT=8080

# TRACE | DEBUG | INFO | WARN | ERROR — applies to com.bsharat.triosuite only.
LOG_LEVEL_APP=INFO

<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only. Overrides the release configuration of the same name.

  Cleartext is permitted in both variants (see src/main/res/xml/network_security_config.xml for
  why), so the one thing this file adds is trust in user-installed certificate authorities. That
  lets a developer put a proxy such as Charles or mitmproxy in front of the app and read its
  traffic, which the release build deliberately does not allow.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>

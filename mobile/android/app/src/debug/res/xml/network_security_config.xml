<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only. Overrides the release configuration of the same name.

  Allows plain HTTP to exactly three hosts: the Android emulator's alias for the host machine, the
  loopback address, and localhost. Everything else — including any real deployment — still requires
  HTTPS, so a developer cannot accidentally test against a production URL over cleartext.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <!-- Lets a developer inspect traffic with a locally installed proxy certificate. -->
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <!-- The emulator's alias for the host machine. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
